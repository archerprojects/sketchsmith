<?xml version="1.0" encoding="UTF-8"?>
<!--
  SketchSmith — MIME type for SketchUp files
  Version 1.0.0 (initial release) — Thursday 12 November 2026
  No system MIME type exists for .skp; the name is Apache Tika's (not registered with IANA).
  The magic is the file's opening "SketchUp Model" header, in UTF-16.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.sketchup.skp">
    <comment>SketchUp model</comment>
    <acronym>SKP</acronym>
    <generic-icon name="model"/>
    <magic priority="50">
      <match type="string" offset="0" value="\xff\xfe\xff\x0eS\x00k\x00e\x00t\x00c\x00h\x00U\x00p\x00 \x00M\x00o\x00d\x00e\x00l\x00"/>
    </magic>
    <glob pattern="*.skp"/>
  </mime-type>
</mime-info>
